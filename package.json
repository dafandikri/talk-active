{
  "name": "talk-active-workspace",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A persistent rubric-grounded rehearsal workspace for Indonesian students.",
  "scripts": {
    "build": "pnpm --filter @talk-active/web build",
    "build:production": "pnpm --filter @talk-active/web build",
    "check": "node --test && pnpm check:production && node scripts/project.mjs check && node scripts/finals-rubric.mjs check && pnpm check:gateway",
    "check:gateway": "node scripts/gateway-key.mjs check",
    "check:production": "pnpm typecheck:production && pnpm build:production && pnpm test:production:browser",
    "check:proposal": "docs/proposal/build.sh",
    "dev": "pnpm --filter @talk-active/web dev",
    "dev:production": "pnpm --filter @talk-active/web dev",
    "finals": "node scripts/finals-rubric.mjs gate",
    "golden:capture": "node scripts/capture-golden.mjs",
    "project": "node scripts/project.mjs",
    "rubric": "node scripts/finals-rubric.mjs",
    "setup:hooks": "git config core.hooksPath .githooks && echo \"pre-push gate enabled\"",
    "start": "pnpm --filter @talk-active/web start",
    "status": "node scripts/status.mjs",
    "take": "node scripts/take.mjs",
    "test": "node --test",
    "test:production:browser": "playwright test --config playwright.production.config.ts",
    "typecheck": "pnpm --filter @talk-active/web typecheck",
    "typecheck:production": "pnpm --filter @talk-active/web typecheck"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
