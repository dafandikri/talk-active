# ---------------------------------------------------------------------------
#  Semantic evidence mapping. All of it is optional: with none of these set the
#  product runs deterministic cue matching and says so on screen.
# ---------------------------------------------------------------------------

# ROUTE A — Vercel AI Gateway (requires available Gateway credits).
# `vercel env pull .env.local --environment=development --yes` is the preferred
# local setup; this placeholder documents the variable name without a secret.
# Finals recommendation: use a dedicated key with a hard, non-refreshing quota:
# vercel ai-gateway api-keys create --name talk-active-finals-2026 --budget 5 \
#   --refresh-period none --alert-thresholds 50,75,100 --expiration 7d
AI_GATEWAY_API_KEY=your-gateway-key-here

# ROUTE B — any OpenAI-compatible provider, directly. No Vercel credits needed.
# Google AI Studio issues free keys at https://aistudio.google.com/apikey and
# speaks the same chat/completions shape, so nothing in the code changes.
# Free-tier limits are per Google Cloud project and have been cut before, so
# confirm the current numbers on Google's pricing page rather than trusting a
# note in a repo. As of this writing flash-lite is the most generous.
# TALKACTIVE_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
# TALKACTIVE_API_KEY=your-google-ai-studio-key-here
# TALKACTIVE_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash

# Override the model chain for the gateway route, cheapest-capable first.
# TALKACTIVE_MODELS=anthropic/claude-haiku-4.5,openai/gpt-5-nano
# Production AI model tier. These IDs were resolved against the live Gateway
# model list on 12 August 2026. Re-check that list before a later deployment;
# do not bake an illustrative model into application code. The first ID is
# primary and the comma-separated list is transport fallback. Grounding
# failures are retried by application code, not Gateway.
# Evidence calls place the transcript in a shared prompt-cache prefix, warm one
# criterion, then fan out the rest. Cache eligibility and minimum prompt length
# remain provider/model dependent; emitted usage logs report actual reads/writes.
# Hobby deployments do not request Gateway's Pro-only ZDR option. Criterion-
# scoped text is processed under the configured model provider's data terms;
# keep that boundary visible in the product and never send raw audio here.
AI_EVIDENCE_MODEL=anthropic/claude-haiku-4.5
AI_EVIDENCE_FALLBACK_MODELS=openai/gpt-5-nano,google/gemini-2.5-flash-lite
AI_EVIDENCE_TIMEOUT_MS=22000
AI_RUBRIC_MODEL=anthropic/claude-haiku-4.5
AI_RUBRIC_FALLBACK_MODELS=openai/gpt-5-nano,google/gemini-2.5-flash-lite
AI_RUBRIC_TIMEOUT_MS=22000
AI_QUESTION_MODEL=anthropic/claude-haiku-4.5
AI_QUESTION_FALLBACK_MODELS=openai/gpt-5-nano,google/gemini-2.5-flash-lite
AI_QUESTION_TIMEOUT_MS=22000
AI_DEFENSE_MODEL=anthropic/claude-haiku-4.5

# Paid model routes remain unavailable unless all three rate-limit secrets are
# configured. Requests are checked against a per-route token bucket for both a
# pseudonymized IP and, when signed in, a pseudonymized user ID. Persisted
# evidence review costs five tokens; stateless analysis costs six because it
# includes the evidence fan-out and one judge question. Other paid routes cost
# one. Fully semantic stateless results are cached by transcript+rubric hash for
# up to 24 hours; raw transcripts are not stored in that cache. The bucket
# refills every ten minutes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_RATE_LIMIT_HASH_SECRET=
AI_RATE_LIMIT_REFILL_TOKENS=20
AI_RATE_LIMIT_MAX_TOKENS=20

# Account sync is optional. Without all three values the application keeps the
# fully supported local guest path and the auth route returns a typed 503.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:4173

# Private Vercel Blob store for student-supplied source documents. Source
# uploads remain unavailable unless both this and DATABASE_URL are configured.
# Only UTF-8 text, Markdown, and JSON are accepted in the current boundary.
BLOB_READ_WRITE_TOKEN=
